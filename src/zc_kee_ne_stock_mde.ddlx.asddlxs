@Metadata.layer: #CORE

annotate view ZC_kee_NE_STOCK with
{
    @UI.facet: [
        {
            id: 'StockGeneral',
            type: #IDENTIFICATION_REFERENCE,
            label: 'Stock Details',
            position: 10
        },
        {
            id: 'Actions',
            type: #LINEITEM_REFERENCE,
            label: 'Actions',
            position: 20,
            targetElement: '_Action'
        }
    ]

    @UI.lineItem: [
        { position: 10, importance: #HIGH }
    ]
    @UI.selectionField: [
        { position: 10 }
    ]
    @UI.identification: [
        { position: 10 }
    ]
    MaterialId;

    @UI.lineItem: [
        { position: 20, importance: #HIGH }
    ]
    @UI.selectionField: [
        { position: 20 }
    ]
