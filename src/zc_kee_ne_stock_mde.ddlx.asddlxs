        { position: 30 }
    ]
    @UI.identification: [
        { position: 30 }
    ]
    ManufactureDate;

    @UI.lineItem: [
        { position: 40 }
    ]
    @UI.selectionField: [
        { position: 40 }
    ]
    @UI.identification: [
        { position: 40 }
    ]
    ExpiryDate;

    @UI.lineItem: [
        { position: 50 }
    ]
    @UI.identification: [
        { position: 50 }
    ]
    Quantity;

    @UI.lineItem: [
        { position: 60 }
    ]
    @UI.selectionField: [
        { position: 50 }
    ]
    @UI.identification: [
        { position: 60 }
    ]
    Unit;

    @UI.lineItem: [
        { position: 70 }
    ]
    @UI.selectionField: [
        { position: 60 }
    ]
    @UI.identification: [
        { position: 70 }
    ]
    Plant;

    @UI.lineItem: [
        { position: 80 }
    ]
    @UI.selectionField: [
        { position: 70 }
    ]
    @UI.identification: [
        { position: 80 }
    ]
    StorageLocation;

    @UI.lineItem: [
        { position: 90 }
    ]
    @UI.selectionField: [
        { position: 80 }
    ]
    @UI.identification: [
        { position: 90 }
    ]
    Vendor;

    @UI.lineItem: [
        { position: 100 }
    ]
    @UI.selectionField: [
        { position: 90 }
    ]
    @UI.identification: [
        { position: 100 }
    ]
    RemainingDays;

    @UI.lineItem: [
        { position: 110 }
    ]
    @UI.selectionField: [
        { position: 100 }
    ]
    @UI.identification: [
        { position: 110 }
    ]
    ExpiryStatus;

    @UI.lineItem: [
        { position: 120 }
    ]
    @UI.selectionField: [
        { position: 110 }
    ]
    @UI.identification: [
        { position: 120 }
    ]
    Priority;

    @UI.lineItem: [
        { position: 130 }
    ]
    @UI.selectionField: [
        { position: 120 }
    ]
    @UI.identification: [
        { position: 130 }
    ]
    RecommendedAction;
}